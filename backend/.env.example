# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Remember to add your IP address under Atlas > Network Access.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dreamsonwheel?retryWrites=true&w=majority
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change me
JWT_EXPIRES_IN=7d

# Website (5173) and admin panel (5174) origins allowed to call this API (comma separated, no spaces needed)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Seed accounts (used only by `npm run seed`)
ADMIN_EMAIL=admin@dreamsonwheel.com
ADMIN_PASSWORD=Admin@123
DEMO_CUSTOMER_PASSWORD=Demo@123
